# Native Uvicorn reads this file only with --env-file .env.
# Copy to .env; shell environment variables take precedence.
# Replace with an absolute local path shared by every native instance.
# Windows example: sqlite:///C:/path/to/checkout/operations-v2.db
# POSIX example: sqlite:////absolute/path/operations-v2.db
# This portable relative default must be replaced for multi-instance use.
DATABASE_URL=sqlite:///./operations-v2.db
# Keep fixture traffic disabled for the trusted-source contract demonstration.
MOCK_AUTOSTART=false
MOCK_EVENTS_PER_SECOND=50
# Redis is supplementary; unavailable Redis degrades health, not SQL reads/writes.
# Compose uses its own internal Redis URL and container SQLite path.
REDIS_URL=redis://127.0.0.1:6379/0
# Summary backlog count and out-for-delivery delay threshold in minutes.
BACKLOG_THRESHOLD=30
DELAY_MINUTES=30

# Enable the isolated, allowlisted website test runner.
VERIFICATION_ENABLED=false
# Set both locally in .env or in the backend host's secret environment settings.
# No hardcoded login fallback exists. Never use VITE_ for credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional alternative to ADMIN_PASSWORD (takes precedence when nonempty):
# pbkdf2_sha256$iterations$salt_hex$digest_hex
# ADMIN_PASSWORD_HASH=
# Use true on an HTTPS deployment; false is only for local HTTP.
AUTH_COOKIE_SECURE=false
